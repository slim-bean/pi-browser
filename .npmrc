; pi bundles @earendil-works/* and typebox and aliases those specifiers for
; extensions, so the peerDependencies here must never be installed into this
; package's node_modules (npm >= 7 would otherwise fetch a second copy of pi,
; ~60 packages, on every `pi install`).
;
; legacy-peer-deps is the setting that matters: pi installs git packages with
; `npm install --omit=dev`, and a CLI --omit replaces the omit array from this
; file. legacy-peer-deps is untouched by that, so peers stay uninstalled.
legacy-peer-deps=true
omit=peer
